{
  "name": "greenlink",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "start:backend": "npm run start --workspace=backend",
    "start:mobile": "npm run start --workspace=@greenlink/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
